import { useState } from 'react'
import type { RecommendedSong } from '../types'

interface SongCardProps {
  song: RecommendedSong
}

const energyLabel: Record<number, string> = {
  1: 'Calm',
  2: 'Relaxed',
  3: 'Moderate',
  4: 'Upbeat',
  5: 'High-intensity',
}

export function SongCard({ song }: SongCardProps) {
  const [feedback, setFeedback] = useState<'up' | 'down' | null>(null)

  function toggleFeedback(next: 'up' | 'down') {
    setFeedback((current) => (current === next ? null : next))
  }

  return (
    <article className="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
      <div className="flex gap-3">
        <img
          src={song.image || 'https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=400&q=80'}
          alt={song.title}
          className="h-16 w-16 rounded-xl object-cover"
          loading="lazy"
        />
        <div className="min-w-0 flex-1">
          <div className="mb-1 flex items-start justify-between gap-2">
            <div>
              <h3 className="truncate text-base font-semibold text-slate-900">{song.title}</h3>
              <p className="text-xs text-slate-500">{song.artist}</p>
            </div>
            <div className="flex items-center gap-1.5">
              <span className="whitespace-nowrap rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                {song.matchScore}%
              </span>
              <button
                type="button"
                onClick={() => toggleFeedback('up')}
                className={`rounded-full border px-2.5 py-1 text-xs font-semibold transition ${
                  feedback === 'up'
                    ? 'border-sky-300 bg-sky-100 text-sky-700'
                    : 'border-sky-100 bg-sky-50 text-sky-600 hover:border-sky-200 hover:bg-sky-100'
                }`}
                aria-label={`Thumbs up for ${song.title}`}
              >
                <ThumbUpIcon />
              </button>
              <button
                type="button"
                onClick={() => toggleFeedback('down')}
                className={`rounded-full border px-2.5 py-1 text-xs font-semibold transition ${
                  feedback === 'down'
                    ? 'border-sky-300 bg-sky-100 text-sky-700'
                    : 'border-sky-100 bg-sky-50 text-sky-600 hover:border-sky-200 hover:bg-sky-100'
                }`}
                aria-label={`Thumbs down for ${song.title}`}
              >
                <ThumbDownIcon />
              </button>
            </div>
          </div>
          <div className="mb-2 flex flex-wrap gap-1.5 text-[11px]">
            <Badge label={song.genre} />
            <Badge label={song.tempo} />
            <Badge label={song.mood} />
            <Badge label={energyLabel[song.energy] ?? `${song.energy}`} />
          </div>
          <p className="text-xs text-slate-600">{song.explanation.replace(/\./g, "")}</p>
        </div>
      </div>
    </article>
  )
}

function Badge({ label }: { label: string }) {
  return <span className="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-slate-600">{label}</span>
}

function ThumbUpIcon() {
  return (
    <svg viewBox="0 0 24 24" className="h-4 w-4" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
      <path d="M7 10v10" />
      <path d="M12 3l-1 7h8a2 2 0 0 1 2 2l-1 6a2 2 0 0 1-2 2H7V10l5-7z" />
    </svg>
  )
}

function ThumbDownIcon() {
  return (
    <svg viewBox="0 0 24 24" className="h-4 w-4" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
      <path d="M7 14V4" />
      <path d="M12 21l-1-7h8a2 2 0 0 0 2-2l-1-6a2 2 0 0 0-2-2H7v10l5 7z" />
    </svg>
  )
}
